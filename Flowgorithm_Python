print("=== FOOD & BEVERAGE MENU ===" + chr(13) + "1. Burger - $5.50" + chr(13) + "2. Fries - $2.50" + chr(13) + "3. Soda - $1.50" + chr(13) + "Enter your choice number:")
choice = int(input())
if choice == 1:
    subtotal = 5.5
else:
    if choice == 2:
        subtotal = 2.5
    else:
        if choice == 3:
            subtotal = 1.5
